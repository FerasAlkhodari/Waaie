# DeepSeek API key — get one at https://platform.deepseek.com/api_keys
# NEVER commit your real key. Copy this file to .env and fill it in locally.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: override the DeepSeek model (defaults to deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Per-client rate limit for the /ask endpoint (slowapi syntax)
RATE_LIMIT=20/minute
