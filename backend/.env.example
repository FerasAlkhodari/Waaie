# Google Gemini API key — get one at https://aistudio.google.com/apikey
# NEVER commit your real key. Copy this file to .env and fill it in locally.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Per-client rate limit for the /ask endpoint (slowapi syntax)
RATE_LIMIT=20/minute
