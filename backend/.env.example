# DeepSeek API key — get one at https://platform.deepseek.com/api_keys
# NEVER commit your real key. Copy this file to .env and fill it in locally.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: override the DeepSeek model (defaults to deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Per-client rate limit for the /ask endpoint (slowapi syntax)
RATE_LIMIT=20/minute

# --- Interactive Question Generator (بنك الأسئلة) ---
# Optional: secret used to HMAC-seal each quiz question's answer so the stateless
# /quiz/answer endpoint can grade a tampered-proof token. A dev default is used
# if unset; set a strong, STABLE value in production (identical across instances,
# or sealed tokens issued by one instance won't verify on another).
# QUIZ_SECRET=change-me-to-a-long-random-string
#
# Optional: output-token ceiling for the SINGLE bulk call that builds a whole
# quiz (POST /quiz/start). Raise it if long 30-question quizzes come back
# truncated/invalid; lower it to cap spend. Only affects the quiz batch path —
# the chat default is unchanged. Defaults to 8000.
# QUIZ_BULK_MAX_TOKENS=8000

# --- Realtime voice (/voice WebSocket) ---
# OpenAI API key — used ONLY server-side for the Realtime voice proxy.
# Get one at https://platform.openai.com/api-keys. Never expose to the frontend.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the realtime model (defaults to gpt-realtime-mini).
# GA models: gpt-realtime-mini (cheap) or gpt-realtime. The old
# gpt-4o-*-realtime-preview models are the decommissioned beta and will fail.
# OPENAI_REALTIME_MODEL=gpt-realtime-mini
# Optional: TTS voice (alloy, echo, shimmer, marin, cedar, ...). Defaults to alloy.
# OPENAI_REALTIME_VOICE=alloy
# Optional: hard per-call timeout in seconds (defaults to 300 = 5 minutes)
# VOICE_MAX_CALL_SECONDS=300
