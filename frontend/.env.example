# Base URL of the Waaie FastAPI backend.
# In production this is the relative path "/api" — nginx reverse-proxies it to
# the backend over the internal Docker network (see frontend/nginx.conf), so the
# frontend and backend share one public origin with no CORS and no subdomain.
# For local dev against a directly-run backend, use http://localhost:8000.
REACT_APP_BACKEND_URL=/api
